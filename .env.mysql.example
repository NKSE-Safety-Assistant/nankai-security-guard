DB_MODE=mysql
MYSQL_CLI=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysql.exe
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=nankai_security_guard
PORT=8021

# 本地演示可设为 false；接入飞书时改为 true 并完善下方配置。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 选填。设置后额外校验飞书用户所属组织。
FEISHU_TENANT_KEY=
PUBLIC_BASE_URL=http://localhost:8021
FEISHU_REDIRECT_URI=http://localhost:8021/api/auth/callback
FEISHU_SCOPE=
# 生产环境设置独立的随机值，至少 32 个字符
SESSION_SECRET=
FEISHU_EDITOR_WEBHOOK_URL=
FEISHU_REVIEWER_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=

